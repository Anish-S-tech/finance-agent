DATABASE_URL="file:./dev.db"
PORT=4000

# AI provider: "claude", "openai", or "gemini"
AI_PROVIDER=claude

# Used when AI_PROVIDER=claude (get a key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Used when AI_PROVIDER=openai (get a key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used when AI_PROVIDER=gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
