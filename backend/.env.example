# Supabase project settings — find these in Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose this to the frontend
SUPABASE_JWT_SECRET=your-jwt-secret                # Project Settings > API > JWT Settings

ENV=development
CORS_ORIGINS=http://localhost:5173

# ---------- AI mentor (Google Gemini) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used only when the main model is busy (Gemini "high demand" errors). Leave blank to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=60
